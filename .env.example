# Telephony (Exotel)
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_ACCOUNT_SID=
# Exotel's REST host varies by account cluster/region, e.g. api.in.exotel.com (Mumbai) or api.exotel.com (Singapore).
EXOTEL_API_BASE_URL=
# Id of a pre-built Exotel App Bazaar flow (Call Start -> Voicebot Applet -> Hangup)
# whose Voicebot Applet points at VOICE_SERVICE_WS_URL. One-time manual setup per
# Exotel account — apps/api attaches this same flow to every number it provisions.
EXOTEL_VOICEBOT_FLOW_ID=
# Public WebSocket URL of the pilot's single voice-service deployment (wss://...).
VOICE_SERVICE_WS_URL=

# Malayalam STT/TTS (Sarvam AI)
SARVAM_API_KEY=

# Dialogue LLM
ANTHROPIC_API_KEY=

# Data
DATABASE_URL=
REDIS_URL=

# Auth (better-auth, apps/api)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Dashboard -> API (apps/frontend)
NEXT_PUBLIC_API_URL=
