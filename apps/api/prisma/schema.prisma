
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  planTier    PlanTier?    @map("plan_tier")
  members     Member[]
  invitations Invitation[]

  businessProfile BusinessProfile?
  phoneNumbers    OrgPhoneNumber[]

  @@unique([slug])
  @@map("organization")
}

enum PlanTier {
  STARTER
  GROWTH
  PRO

  @@map("plan_tier")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

enum PhoneNumberSource {
  NEW
  FORWARDED

  @@map("phone_number_source")
}

enum PhoneNumberProvisioningStatus {
  PENDING
  PURCHASED
  FAILED

  @@map("phone_number_provisioning_status")
}

enum PhoneNumberRoutingStatus {
  PENDING
  AUTO_CONFIGURED
  MANUAL_SETUP_REQUIRED

  @@map("phone_number_routing_status")
}

/// An org's own inbound phone number(s) — the number callers dial that
/// voice-service resolves to a business_profiles row. Not yet consumed by
/// voice-service (still hardcoded via BUSINESS_ID env var, see
/// apps/voice-service/src/voice_service/call_context.py) — this table exists
/// so a future multi-tenant voice-service session has org-to-number
/// resolution to read from.
model OrgPhoneNumber {
  id          String   @id @default(uuid())
  orgId       String   @map("org_id")
  /// E.164 format, e.g. +919999999999. Null until Exotel purchase succeeds.
  phoneNumber String?  @unique @map("phone_number")

  source PhoneNumberSource @default(NEW) @map("source")
  /// Org's own pre-existing number — set only when source = FORWARDED. The
  /// number callers currently dial; org forwards it (carrier-level) onto
  /// `phoneNumber` once purchased.
  forwardingFromNumber String? @map("forwarding_from_number")

  provisioningStatus PhoneNumberProvisioningStatus @default(PENDING) @map("provisioning_status")
  /// Exotel's Sid for the purchased ExoPhone (distinct from the E.164
  /// string) — needed for later Exotel API calls (Flow/App attach, release).
  exotelPhoneSid String? @unique @map("exotel_phone_sid")

  routingStatus PhoneNumberRoutingStatus @default(PENDING) @map("routing_status")
  /// Id of the Exotel App/Flow created to point the number at voice-service's
  /// WS URL. Null when routing was never attempted or fell back to manual.
  exotelFlowSid String? @map("exotel_flow_sid")

  /// Set the first time the org clicks "verify" — the lower bound used to
  /// look up a matching CallTranscript row on subsequent verify calls.
  verificationRequestedAt DateTime? @map("verification_requested_at")
  /// Set once a CallTranscript created at/after verificationRequestedAt is
  /// found, confirming the test call reached voice-service end-to-end.
  forwardingVerifiedAt DateTime? @map("forwarding_verified_at")

  /// Human-readable detail on the most recent provisioning/routing failure,
  /// surfaced in the dashboard. Cleared on the next successful step.
  lastError String? @db.Text @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@map("org_phone_numbers")
}

/// One row per organization's business. orgId is the tenant boundary —
/// Service / BusinessHours / Appointment stay scoped through businessId and
/// inherit tenancy transitively through this relation, so they never need
/// their own orgId column.
model BusinessProfile {
  id          String   @id @default(uuid())
  /// FK to better-auth's organization table. Unique: one business per org
  /// for this pilot model.
  orgId       String   @unique @map("org_id")
  name        String
  nameLocal   String?  @map("name_local")
  location    String?
  description String?  @db.Text
  /// Freeform FAQ-style notes (parking, walk-ins, payment methods, etc.) —
  /// eventual source of truth for voice-service's ORG_CONTEXT string.
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  services        Service[]
  businessHours   BusinessHours[]
  appointments    Appointment[]
  inquiries       Inquiry[]
  callTranscripts CallTranscript[]

  @@map("business_profiles")
}

model Service {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  name            String
  /// Local-language name (e.g. Malayalam) — callers name services in the
  /// call's language, not English, so booking lookups match against this too.
  nameLocal       String?  @map("name_local")
  description     String?  @db.Text
  durationMinutes Int      @map("duration_minutes")
  price           Decimal  @db.Decimal(10, 2)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business     BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@map("services")
}

/// dayOfWeek: 0 = Sunday .. 6 = Saturday (matches JS Date#getDay()).
/// open/close stored as minutes-since-midnight ints, not a Postgres `time`
/// column — Prisma models `time` as DateTime @db.Time, which round-trips
/// through JS Date and is a timezone footgun. Plain ints are trivial to
/// validate/compare.
model BusinessHours {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  dayOfWeek  Int      @map("day_of_week")
  openTime   Int      @map("open_time_minutes")
  closeTime  Int      @map("close_time_minutes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, dayOfWeek])
  @@map("business_hours")
}

enum AppointmentStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("appointment_status")
}

model Appointment {
  id               String            @id @default(uuid())
  businessId       String            @map("business_id")
  serviceId        String            @map("service_id")
  customerName     String            @map("customer_name")
  customerPhone    String            @map("customer_phone")
  scheduledAt      DateTime          @map("scheduled_at") @db.Timestamptz(3)
  status           AppointmentStatus @default(CONFIRMED)
  bookingReference String            @unique @map("booking_reference")
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([scheduledAt])
  @@map("appointments")
}

enum InquiryCategory {
  BUSINESS_QUESTION
  OFF_TOPIC
  NO_BOOKING_NEEDED
  OTHER

  @@map("inquiry_category")
}

/// Telemetry for turns that go off the booking rails — a business question,
/// an off-topic remark, or a call that wasn't about booking at all. Written
/// by voice-service's log_inquiry tool; not part of the booking flow itself.
model Inquiry {
  id         String          @id @default(uuid())
  businessId String          @map("business_id")
  category   InquiryCategory
  summary    String          @db.Text
  createdAt  DateTime        @default(now()) @map("created_at")

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("inquiries")
}

enum CallOutcome {
  BOOKED
  INQUIRY
  NO_OUTCOME

  @@map("call_outcome")
}

/// Written by voice-service when a call ends: the full LLM conversation plus
/// how it resolved. callId is Exotel's call sid — unique so a retried POST
/// (e.g. voice-service crash-retry) upserts instead of erroring.
model CallTranscript {
  id               String      @id @default(uuid())
  businessId       String      @map("business_id")
  callId           String      @unique @map("call_id")
  customerPhone    String      @map("customer_phone")
  outcome          CallOutcome
  bookingReference String?     @map("booking_reference")
  transcript       Json
  startedAt        DateTime    @map("started_at")
  endedAt          DateTime    @map("ended_at")
  createdAt        DateTime    @default(now()) @map("created_at")

  business BusinessProfile @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("call_transcripts")
}
